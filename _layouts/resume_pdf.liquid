---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
  </header>
  <article>
    {% if page.cv_pdf %}
      {% assign pdf_url = page.cv_pdf | relative_url %}{% if page.cv_pdf_version %}{% assign pdf_url = pdf_url | append: "?v=" | append: page.cv_pdf_version %}{% endif %}
      <p class="mb-3">
        <a href="{{ pdf_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <i class="fa-solid fa-file-pdf"></i> Open PDF in new tab
        </a>
      </p>
      <iframe src="{{ pdf_url }}#toolbar=1" class="w-100 border" style="min-height: 80vh; height: 80vh;" title="Resume PDF"></iframe>
    {% else %}
      <p>No resume PDF configured. Set <code>cv_pdf</code> in your resume page front matter.</p>
    {% endif %}
  </article>
</div>
